// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  nurse // Healthcare caregiver
  admin // Full portal access
  biller // Third-party billing access
  provider // Other medical provider (non-nurse)
  guardian // Parent / family member of patient
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  // internal name shown to admin; set during account creation
  name     String
  role     Role   @default(nurse)

  // MFA / 2FA
  phone           String?
  smsOtp          String?
  smsOtpExpiresAt DateTime?
  mfaSecret       String?
  mfaEnabled      Boolean   @default(false)
  twoFaConsentAt  DateTime? // when non-admin user acknowledged 2FA enrollment

  passwordResetToken  String?
  passwordResetExpiry DateTime?
  lastLoginAt         DateTime?

  // Peer-to-peer messaging — email alert on new message (receiving itself
  // can't be opted out of, only whether the nav badge shows a count or a
  // plain dot; see Message/MessageRecipient below).
  notifyNewMessage Boolean @default(true)

  // Stored e-signature for non-nurse authors (currently: admin) on Progress
  // Notes and their addenda. Nurses keep using NurseProfile.signatureImageKey
  // — this is a deliberate asymmetry, not a duplicate, to avoid touching the
  // already-shipped nurse e-sig feature.
  signatureImageKey String?
  signatureSavedAt  DateTime?

  nurseProfile          NurseProfile?
  guardianLinks         GuardianPatient[]
  sentMessages          Message[]              @relation("MessageSender")
  messageRecipients     MessageRecipient[]
  authoredProgressNotes ProgressNote[]
  progressNoteAddenda   ProgressNoteAddendum[]
  createdAt             DateTime               @default(now())
}

model NurseProfile {
  id          String @id @default(uuid())
  userId      String @unique
  displayName String // name the nurse chooses for themselves

  accountNumber String? @unique

  // Individual provider — nurse-editable
  firstName      String?
  middleInitial  String?
  lastName       String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zip            String?
  dob            String? // stored as plain text date string
  ssnEncrypted   String? // AES-256-GCM encrypted
  npiNumber      String?
  medicaidNumber String?
  etin           String? // Electronic Transmitter Identification Number (3-4 chars)
  epacesUserId   String? // ePaces system user ID
  credentials    String? // e.g. "RN", "LPN" — shown on the "Recorded by" note on patient orders

  // Business provider — admin-managed, conditional
  hasBusinessProvider Boolean @default(false)
  bizServiceAddress   String?
  bizEntityName       String?
  bizPhone            String?
  bizEmail            String?
  einEncrypted        String? // AES-256-GCM encrypted
  feinEncrypted       String? // AES-256-GCM encrypted
  bizNpiType          String? // 'Type1' | 'Type2'
  bizNpi              String?
  bizMedicaidId       String?
  bizCity             String?
  bizState            String?
  bizZip              String?

  // Payment — admin-managed
  bankName             String?
  bankRoutingEncrypted String? // AES-256-GCM encrypted
  bankAccountEncrypted String? // AES-256-GCM encrypted

  // Onboarding & agreement
  onboardingComplete  Boolean   @default(false)
  enrolledInBilling   Boolean?
  carrierCount        Int?
  billingDurationType String? // 'full_year' | 'policy_specific'
  billingDurationNote String?
  billingPlan         String? // 'A1' | 'A2' | 'B' | 'custom'
  planStartDate       String?
  agreementSignedAt   DateTime?
  agreementSignature  String?
  agreementIp         String?

  // Reusable drawn e-signature — captured once (profile page or dashboard
  // prompt), reused by future signing flows (Progress Notes, etc.). Consumers
  // that need a document's signature to stay immutable after the fact should
  // snapshot/copy this image at the moment of signing, not reference it live —
  // this field is "the nurse's current signature," not a historical record.
  signatureImageKey String?
  signatureSavedAt  DateTime?

  // Legacy
  billingInfo String?

  // Notification preferences — reminders
  receiveNotifications  Boolean @default(true) // weekly hour submission reminder (legacy)
  notifyBillingReminder Boolean @default(true) // billing-related reminders
  notifyDocExpiring     Boolean @default(true) // document/license expiration reminders
  // Notification preferences — alerts
  notifyNewDocument     Boolean @default(true) // alert when admin uploads a document
  notifyNewClaim        Boolean @default(true) // alert when a new claim is added

  // Admin text alert throttle — last date (YYYY-MM-DD) an admin was texted
  // "New hours added for [this nurse]"; caps that alert at once per nurse per day.
  hoursAlertSentDate String?

  // Self-reported type from public signup form
  signupRole String? // 'Nurse' | 'Patient' | 'Billing Service' | 'Other'

  // Portal user agreement — required on first login
  portalAgreementSignedAt DateTime?
  portalAgreementInitials String?

  // Billing service agreement — signed during onboarding when enrolling in billing
  billingAgreementSignedAt DateTime?
  billingAgreementInitials String?

  // Demo/test account — excluded from metrics, all writes blocked
  isDemo Boolean @default(false)

  // Billing enrollment status — admin-managed
  // 'Active' | 'Termed' | 'Seasonal' | 'Pending' | null (never enrolled)
  billingStatus    String?
  serviceStartDate String?
  serviceEndDate   String?

  // Portal subscription tier
  planTier       String    @default("FREE") // FREE | BASIC | PRO
  trialExpiresAt DateTime? // if set, nurse gets BASIC access until this date

  // Directory opt-in
  dirOptIn     Boolean @default(true)
  dirShowEmail Boolean @default(true)
  dirShowPhone Boolean @default(true)

  user                User                 @relation(fields: [userId], references: [id])
  timeEntries         TimeEntry[]
  claims              Claim[]
  enrollmentLogs      EnrollmentLog[]
  invoices            Invoice[]
  reminders           NurseReminder[]
  shifts              Shift[]
  documents           NurseDocument[]
  invoiceActivities   InvoiceActivity[]
  caseAssignments     CaseAssignment[]
  medicaidClaims      MedicaidClaim[]
  campaignEnrollments CampaignEnrollment[]
  providerCredits     ProviderCredit[]
  nursePatients       NursePatient[]
  routedForms         RoutedForm[]
  medicaidPayWeekLogs MedicaidPayWeekLog[]
  quickAccessTokens   NurseQuickAccessToken[]
}

// Admin-configurable matrix of which profile "cards" (Demographics, Billing
// Info, Banking) render on a given role's profile page — lets Alex add/remove
// a card per role without a code deploy. Every role's profile data still lives
// on NurseProfile itself (see lib/profileCards.ts); this table only controls
// visibility, not storage.
model ProfileCardConfig {
  id      String  @id @default(uuid())
  cardKey String // 'demographics' | 'billing_info' | 'banking'
  // Deliberately String, not the Role enum: role is stored as plain TEXT
  // throughout this schema (no native Postgres enum type exists anywhere in
  // this database — see User.role), and every other role check in this
  // codebase compares in JS after fetching. Typing this Role would make
  // Prisma cast WHERE role = $1 against a nonexistent native enum type and
  // throw at query time the moment anything actually filters by it.
  role    String
  enabled Boolean @default(true)

  @@unique([cardKey, role])
}

model RoutedForm {
  id             String       @id @default(uuid())
  nurseId        String
  nurse          NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  title          String
  category       String       @default("Form")
  storageKey     String? // S3 key for the blank/pre-filled form
  fileName       String?
  urgent         Boolean      @default(false)
  routedBy       String // admin display name
  status         String       @default("pending") // pending | signed
  notes          String?
  signedKey      String? // S3 key for the returned signed form
  signedFileName String?
  signedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([nurseId])
  @@index([status])
}

model FormTemplate {
  id         String   @id @default(uuid())
  title      String   @unique
  storageKey String
  fileName   String
  fileSize   Int?
  mimeType   String?
  uploadedBy String   @default("admin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GlobalEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  category    String   @default("general") // 'tax' | 'renewal' | 'compliance' | 'general'
  targetRoles String[] @default([]) // empty = visible to all; otherwise ['nurse','biller',...]
  recurrence  String? // 'quarterly' | 'annual' | null (one-time)
  createdBy   String? // admin user id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventDate])
}

model NurseReminder {
  id        String   @id @default(uuid())
  nurseId   String
  title     String
  category  String   @default("general") // 'license' | 'medicaid' | 'bcbs' | 'npi' | 'insurance' | 'general'
  dueDate   DateTime
  notes     String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId])
}

model EnrollmentLog {
  id               String   @id @default(uuid())
  nurseId          String
  nurseDisplayName String
  action           String // 'opted_out' | 'opted_in' | 're_enrolled'
  note             String?
  sentTo           String?
  emailSent        Boolean  @default(false)
  createdAt        DateTime @default(now())

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
}

model TimeEntry {
  id       String   @id @default(uuid())
  nurseId  String
  workDate DateTime
  hours    Float
  notes    String?
  billed   Boolean  @default(false)

  // Invoice flagging
  readyToInvoice Boolean  @default(false)
  invoiceFeePlan String? // 'A1' | 'A2' | 'B' | 'C'
  invoiceFeeAmt  Float?
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  claimRef       String? // optional claim reference number for billing lookup
  patientId      String? // optional patient this entry is billed against
  patient        Patient? @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())

  nurse NurseProfile @relation(fields: [nurseId], references: [id])

  @@unique([nurseId, workDate, patientId])
}

model Invoice {
  id            String    @id @default(uuid())
  nurseId       String
  invoiceNumber String    @unique
  grossAmount   Float // sum of entry fees before discount
  discountAmt   Float     @default(0)
  discountNote  String? // e.g. "Campaign: FB Spring 2026" or "Manual courtesy"
  totalAmount   Float // grossAmount - discountAmt (what nurse owes)
  paidAmount    Float     @default(0)
  dueTerm       String // '30' | '60' | '90' | 'ASAP'
  dueDate       DateTime
  status        String    @default("Sent") // Sent | Partial | Paid | Disputed | WrittenOff | Overdue
  notes         String?
  nurseEmail    String
  nurseName     String
  sentAt        DateTime  @default(now())
  paidAt        DateTime?
  s3Key         String?

  campaignEnrollmentId String?
  campaignEnrollment   CampaignEnrollment? @relation(fields: [campaignEnrollmentId], references: [id], onDelete: SetNull)

  // Late fee policy (set per invoice at creation time)
  lateFeePlan    String? // 'none' | 'flat' | 'percent'
  lateFeeAmt     Float? // flat: dollars per month overdue
  lateFeePercent Float? // percent: % per month overdue (e.g. 1.5 = 1.5%)

  // Prompt-pay bonus: credit applied to next invoice if paid within window
  promptPayCredit Float? // dollar credit (e.g. 5.00)
  promptPayDays   Int? // days from invoice date to qualify (e.g. 14)

  entries         TimeEntry[]
  payments        Payment[]
  activities      InvoiceActivity[]
  providerCredits ProviderCredit[]
  nurse           NurseProfile      @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id          String  @id @default(uuid())
  name        String
  description String?
  type        String // 'flat_per_dos' | 'percent_off'

  // flat_per_dos: charge $X per date of service, capped at $Y per Mon-Sun week
  flatAmtPerDos Float?
  weeklyMaxAmt  Float?

  // percent_off: discount X% off the gross invoice total
  percentOff Float?

  // Time bounds
  startDate DateTime? // when the campaign begins (null = immediate)
  weekCount Int? // how many Mon-Sun weeks it applies (null = indefinite)

  // Promo link hook — unique slug for future /join?ref= flow
  promoSlug String? @unique

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments CampaignEnrollment[]

  @@index([active])
  @@index([promoSlug])
}

model CampaignEnrollment {
  id         String   @id @default(uuid())
  nurseId    String
  campaignId String
  enrolledAt DateTime @default(now())
  active     Boolean  @default(true)

  nurse    NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([nurseId, campaignId])
  @@index([nurseId])
  @@index([campaignId])
}

model ProviderCredit {
  id          String   @id @default(uuid())
  nurseId     String
  amount      Float // positive = credit, negative = charge/late fee
  type        String // 'prompt_pay' | 'late_fee' | 'manual' | 'account_balance'
  description String?
  invoiceId   String?
  // Links an 'account_balance' row to the Payment that created it (overpayment
  // credit) or spent it (paid-via-balance debit), so deleting that payment can
  // reverse the ledger entry instead of leaving a stale balance behind.
  paymentId   String?
  appliedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  nurse   NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  invoice Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([nurseId])
  @@index([invoiceId])
  @@index([paymentId])
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  receiptNumber String   @unique
  amount        Float
  method        String? // Venmo | Zelle | CashApp | ApplePay | Cash | Check | ACH | Other | Account Balance
  note          String?
  s3Key         String?
  appliedAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  providerCredits ProviderCredit[]
}

model InvoiceActivity {
  id           String   @id @default(uuid())
  nurseId      String
  invoiceId    String?
  action       String // 'Email' | 'Print'
  documentType String // 'Invoice' | 'Statement' | 'Receipt'
  reference    String? // e.g. invoice number, receipt number, or "Full Statement"
  note         String?
  createdAt    DateTime @default(now())

  nurse   NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  invoice Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

// Admin's own generated income/tax reports — the equivalent of NurseDocument's
// role for nurse-facing tax reports, but admin has no NurseProfile to hang a
// document off of, so this is its own small table. Just a re-download index;
// the PDF itself lives in S3.
model AdminReport {
  id                String   @id @default(uuid())
  reportType        String // 'income_summary'
  periodLabel       String // "Q2 2026" | "2025" | "2025-2026"
  filterKey         String?
  storageKey        String
  fileName          String
  generatedByUserId String
  createdAt         DateTime @default(now())

  @@index([reportType])
}

model PortalMessage {
  id        String   @id @default(uuid())
  title     String?
  body      String
  category  String   @default("General") // Claims | Invoices | Events | General
  audiences String[] @default([]) // 'All Users' | 'All Nurses' | 'Active Billing' | 'Non-Provider' | 'Admins' | 'user:{nurseProfileId}'
  createdBy String? // admin user id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Peer-to-peer messaging (distinct from PortalMessage above, which is a
// one-way admin broadcast). Any user can message any other user, 1:1 or
// group. Folder membership (Inbox/Drafts/Sent/Saved/Trash) is derived at
// query time from the flags below, not stored as an enum.
model Message {
  id                String    @id @default(uuid())
  senderId          String? // nullable + SetNull below — a deleted sender's messages survive
  senderName        String // snapshot at send time, so display still works after sender deletion
  subject           String?
  body              String    @default("")
  isDraft           Boolean   @default(true)
  draftRecipientIds String[]  @default([]) // recipient picker state while isDraft=true only
  patientId         String? // plain pointer, no FK — "message this patient's care team" context tag
  inReplyToId       String? // plain pointer, no FK — single-level "in reply to", same pattern as Claim.resubmissionOf
  sentAt            DateTime?
  senderSavedAt     DateTime? // sender's own "Saved" flag on their Sent copy
  senderTrashedAt   DateTime? // sender's own "Trash" flag on their Sent copy
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sender     User?              @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipients MessageRecipient[]

  @@index([senderId])
  @@index([sentAt])
}

model MessageRecipient {
  id        String    @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime?
  savedAt   DateTime?
  trashedAt DateTime?
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model AdminIdea {
  id        String   @id @default(uuid())
  body      String
  category  String   @default("Task")
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([completed])
}

model DocumentCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model NurseDocument {
  id                String       @id @default(uuid())
  nurseId           String
  nurse             NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  title             String
  fileName          String
  storageKey        String // S3 object key — never a public URL
  category          String       @default("General") // EOB | License | Contract | Tax | Other | General
  fileSize          Int?
  mimeType          String?
  uploadedBy        String
  nurseUploaded     Boolean      @default(false) // true when nurse uploaded it themselves
  visibleToNurse    Boolean      @default(false) // admin must explicitly share with nurse
  sharedWithAdmin   Boolean      @default(false) // nurse chose to share with admin
  adminReviewed     Boolean      @default(false) // admin has acknowledged the shared doc
  claimId           String? // links to Claim.id for EOB documents
  expiresAt         DateTime?
  reminderDays      Int[]        @default([])
  remindersSentDays Int[]        @default([])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([nurseId])
  @@index([expiresAt])
  @@index([claimId])
}

model PatientDocument {
  id               String   @id @default(uuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title            String
  fileName         String
  storageKey       String // S3 object key — never a public URL
  category         String   @default("General")
  fileSize         Int?
  mimeType         String?
  uploadedByUserId String
  uploadedByRole   String // 'nurse' | 'admin' | 'guardian'
  expiresAt        DateTime?
  reminderSentAt   DateTime? // set once the expiration reminder fires
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Orders-category fields only (category === "Orders") — plain text dates
  // to match the dob/paStartDate convention elsewhere in this schema.
  orderDate    String?
  orderEndDate String?
  providerName String?
  specialty    String?
  orderNotes   String?

  @@index([patientId])
  @@index([expiresAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PendingNotification {
  id        String   @id @default(uuid())
  nurseId   String
  type      String // 'claim' | 'document'
  payload   Json // { claimId?, documentTitle?, category?, dosStart?, dosStop?, totalBilled? }
  createdAt DateTime @default(now())

  @@index([nurseId])
}

model NotificationBatch {
  id           String                   @id @default(uuid())
  sentAt       DateTime                 @default(now())
  trigger      String                   @default("manual") // 'manual' | 'import' | 'cron'
  totalSent    Int                      @default(0)
  totalSkipped Int                      @default(0)
  entries      NotificationBatchEntry[]

  @@index([sentAt])
}

model NotificationBatchEntry {
  id         String            @id @default(uuid())
  batchId    String
  nurseId    String
  nurseName  String
  nurseEmail String
  claims     Json // [{claimId, dosStart, dosStop, totalBilled}]
  documents  Json // [{documentTitle, category}]
  sentOk     Boolean           @default(true)
  batch      NotificationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([nurseId])
}

model FaqItem {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String   @default("General")
  subcategory String   @default("")
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// X12 Claim Adjustment Reason Codes — the standard codes payers use on
// EOBs/835 remittances to explain a claim adjustment (e.g. "45: Charge
// exceeds fee schedule..."). Seeded from https://x12.org/codes/claim-adjustment-reason-codes
// (2026-08-12 snapshot); source-of-record for lookups on the claims pages and
// for the generated reference PDF linked from the FAQ. Deactivated codes are
// kept (not deleted) since old EOBs may still reference them, often with a
// `notes` pointer to the code that replaced them.
model CarcCode {
  id           String    @id @default(uuid())
  code         String    @unique // e.g. "45", "A1", "W8"
  description  String
  active       Boolean   @default(true)
  startDate    DateTime?
  lastModified DateTime?
  stopDate     DateTime?
  notes        String? // e.g. "Use code P19" — replacement pointer on deactivated codes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model PromptPayDocument {
  id        String   @id @default(uuid())
  claimRef  String // claimId text e.g. "CLM-0042"
  claimDbId String? // Claim.id DB UUID (optional)
  s3Key     String
  fileName  String
  version   Int
  createdAt DateTime @default(now())

  @@index([claimRef])
}

model ClaimReminder {
  id        String   @id @default(uuid())
  claimDbId String // Claim.id (DB UUID)
  claimRef  String? // Claim.claimId (display ID e.g. "CLM-0042")
  nurseId   String? // which provider the claim belongs to
  dueDate   DateTime
  reason    String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([claimDbId])
  @@index([dueDate])
}

model Claim {
  id      String @id @default(uuid())
  nurseId String

  // Claim Submission Details
  claimId      String?
  providerName String?
  dosStart     DateTime?
  dosStop      DateTime?
  totalBilled  Float?
  hours        Float?
  claimStage   String?
  submitDate   DateTime? // date the claim was submitted to insurance

  // Prompt Pay tracking
  submitDateReminderSentAt DateTime? // set when the 28-day alert email fires

  // Primary Insurance
  primaryPayer      String?
  primaryAllowedAmt Float?
  primaryCO         Float? // provider obligation / write-off (p-co)
  primaryPaidAmt    Float?
  primaryPaidDate   DateTime?
  primaryPaidTo     String?
  primaryCheckNum   String?

  // Secondary Insurance
  secondaryPayer      String?
  secondaryAllowedAmt Float?
  secondaryCO         Float? // provider obligation / write-off (s-co)
  secondaryPaidAmt    Float?
  secondaryPaidDate   DateTime?
  secondaryPaidTo     String?
  secondaryCheckNum   String?

  // Summary
  totalReimbursed    Float?
  remainingBalance   Float?
  dateFullyFinalized DateTime?
  checkReceivedDate  DateTime?

  // Medicaid pay cycle — only populated when primaryPayer/secondaryPayer is
  // Medicaid. Derived server-side from whichever side's paid date applies via
  // lib/medicaidPayCycle.ts — never trusted from the client. Null for claims
  // billed to non-Medicaid payers.
  estPayCycle Int?
  depositDate DateTime?

  // Notes
  remarkCodes     String? // CARC/RARC remark codes from the EOB, entered by admin; shown to the nurse on their claim
  processingNotes String?

  // Resubmission tracking
  resubmissionOf String? // claimId of the original rejected claim

  // Void tracking — a voided claim keeps all its original fields untouched;
  // the offsetting reversal is a separate row linked only for display purposes.
  voidedAt       DateTime? // set on the ORIGINAL when voided
  voidReversalOf String?   // set on the REVERSAL row — original claim's id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId])
  @@index([claimId])
}

model EmailLog {
  id             String   @id @default(uuid())
  sentAt         DateTime @default(now())
  recipientName  String?
  recipientEmail String
  category       String // 'invoice' | 'receipt' | 'reminder' | 'alert' | 'broadcast' | 'misc'
  subject        String
  bodyS3Key      String? // email-logs/YYYY/MM/[id].html
  status         String   @default("sent") // 'sent' | 'failed'

  @@index([sentAt])
  @@index([recipientEmail])
}

model LoginLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  accountType   String // role: admin, nurse, biller, provider, guardian
  email         String
  firstName     String?
  lastName      String?
  accountNumber String? // nurse account number or null for admin
  result        String // "Success" | "Failed - Invalid credentials" | "Failed - Account not found" | etc.
  ip            String?

  @@index([timestamp])
  @@index([email])
  @@index([result])
}

model ClaimBackup {
  id         String   @id @default(uuid())
  label      String   @default("auto") // 'auto' | 'manual'
  claimCount Int
  snapshot   Json // serialized Claim[] array
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model HomeCase {
  id               String           @id @default(uuid())
  patientFirstName String
  notes            String?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignments      CaseAssignment[]

  @@index([active])
}

model CaseAssignment {
  id       String   @id @default(uuid())
  caseId   String
  nurseId  String
  joinedAt DateTime @default(now())

  homeCase HomeCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  nurse    NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@unique([caseId, nurseId])
  @@index([caseId])
  @@index([nurseId])
}

model MedicaidClaim {
  id             String    @id @default(uuid())
  nurseId        String
  patientCtrlNum String
  payerCtrlNum   String?
  dosStart       DateTime
  dosStop        DateTime
  totalCharge    Float
  paidAmount     Float?
  processedDate  DateTime?
  estPayCycle    Int?
  depositDate    DateTime?
  statusCodes    String[]  @default([])
  notes          String?

  // Void tracking — see Claim.voidedAt/voidReversalOf for the same pattern.
  voidedAt       DateTime?
  voidReversalOf String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId])
  @@index([dosStart])
}

model MedicaidStatusCode {
  code        String   @id
  description String
  createdAt   DateTime @default(now())
}

model ClaimAuditLog {
  id           String   @id @default(uuid())
  claimType    String // 'commercial' | 'medicaid'
  commercialId String? // Claim.id when claimType = 'commercial'
  medicaidId   String? // MedicaidClaim.id when claimType = 'medicaid'
  snapshot     Json // full field values at time of save
  savedAt      DateTime @default(now())
  savedBy      String // admin user id

  @@index([commercialId])
  @@index([medicaidId])
  @@index([savedAt])
}

// ── Patient records ────────────────────────────────────────────────────────

model Patient {
  id             String  @id @default(uuid())
  accountNumber  String  @unique // e.g. "PT-001"
  lastName       String
  firstName      String
  dob            String // plain text, e.g. "1980-01-15"
  gender         String? // 'Male' | 'Female' | 'Other'
  insuranceType  String // 'Medicaid' | 'Commercial' | 'Medicare' | 'Other'
  insuranceId    String // primary member / Medicaid ID
  insuranceName  String? // commercial: carrier name
  insuranceGroup String? // commercial: group number
  insurancePlan  String? // commercial: plan name
  address        String?
  city           String?
  state          String?
  zip            String?
  phone          String?

  // Minor status — drives 2FA contact requirements: adults need their own
  // phone on file, minors instead require a guardian contact card below.
  isMinor              Boolean @default(false)
  guardianFirstName    String?
  guardianLastName     String?
  guardianEmail        String? // only needed if different from the guardian's login email
  guardianPhone        String?
  guardianRelationship String? // 'Parent' | 'Grandparent' | 'Sibling' | 'Child' | 'Other Family' | 'Friend' | 'Legal Guardian' | 'Volunteer Caregiver' | 'Power of Attorney'

  // Provider specialties involved in this patient's care, picked from a
  // fixed checklist on the Demographics tab.
  linkedSpecialties String[] @default([])

  // Clinical / billing
  highTech    Boolean @default(false) // High-Tech designation (yes/no)
  dxCode1     String? // ICD-10 diagnosis code 1
  dxCode2     String?
  dxCode3     String?
  dxCode4     String?
  paNumber    String? // Prior Authorization number
  paStartDate String? // PA effective start date
  paEndDate   String? // PA effective end date

  // Commercial-only demographics
  subscriberName     String? // name of insurance subscriber
  subscriberRelation String? // patient's relation to subscriber

  // Commercial-only policy details
  networkStatus  String? // 'IN' | 'OON'
  hasCaseRate    Boolean @default(false) // agreed case rate exists
  caseRateAmount String? // dollar amount of case rate
  policyNotes    String? // free-text policy rules (e.g. "100-day limit")

  // Secondary / additional insurance
  ins2Type               String? // 'Medicaid' | 'Commercial' | 'Medicare' | 'Other'
  ins2Id                 String? // secondary member ID
  ins2Name               String? // secondary carrier name
  ins2Group              String? // secondary group number
  ins2Plan               String? // secondary plan name
  ins2SubscriberName     String?
  ins2SubscriberRelation String?
  ins2NetworkStatus      String? // 'IN' | 'OON'
  ins2HasCaseRate        Boolean @default(false)
  ins2CaseRateAmount     String?
  ins2PolicyNotes        String?

  // Admin record lock — prevents nurses from editing overrides
  isLocked Boolean   @default(false)
  lockedAt DateTime?
  lockedBy String? // admin display name

  // Notifications & Reminders (patient-wide, admin-controlled)
  documentRemindersEnabled Boolean @default(false) // alert before an uploaded document expires
  paRemindersEnabled       Boolean @default(false) // alert 3 weeks before the current PA end date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nurseLinks    NursePatient[]
  timeEntries   TimeEntry[]
  priorAuths    PatientPA[]
  medications   PatientMedication[]
  guardianLinks GuardianPatient[]
  documents     PatientDocument[]
  shifts        Shift[]
  appointments  Appointment[]
  progressNotes ProgressNote[]
}

model Shift {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Null nurseId = open/coverage-needed, claimable by any nurse linked to this patient.
  nurseId String?
  nurse   NurseProfile? @relation(fields: [nurseId], references: [id], onDelete: SetNull)

  startTime DateTime
  endTime   DateTime

  // 'open' (never assigned) | 'coverage_needed' (was assigned, nurse released it) |
  // 'assigned' | 'completed' | 'cancelled'. 'open' and 'coverage_needed' are both
  // claimable — the distinction is informational only (why is this unclaimed).
  status String @default("open")

  notes String?

  createdByUserId String
  createdByRole   String // 'admin' | 'guardian' — case-management authority. Not 'nurse': nurses don't originate shifts, they claim/work them.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progressNotes ProgressNote[]

  @@index([patientId])
  @@index([nurseId])
  @@index([startTime])
  @@index([status])
}

model Appointment {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  title     String
  location  String?
  provider  String? // free-text clinic/doctor name — no per-appointment provider FK exists
  startTime DateTime
  endTime   DateTime?
  notes     String?

  status String @default("scheduled") // 'scheduled' | 'completed' | 'cancelled' | 'no_show'

  createdByUserId String
  createdByRole   String // 'admin' | 'nurse' | 'guardian' — families are typically the ones arranging appointments directly with physicians

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([startTime])
  @@index([status])
}

model ProgressNote {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  authorUserId String?
  authorUser   User?  @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorRole   String // 'nurse' | 'admin' — denormalized, avoids a role join everywhere it's displayed/filtered
  authorDisplayNameSnapshot String? // frozen at sign time — survives the author's account being deleted later (see lib/progressNoteAuthor.ts)

  shiftId String?
  shift   Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  serviceDate    DateTime
  shiftStartTime String? // clock time as entered, e.g. "08:00 AM" — not a full DateTime
  shiftEndTime   String?
  totalHours     Float?
  location       String? @default("Home") // where the shift took place — free text, defaults to "Home" but editable per note

  arrivalFindings String?
  shiftNotes      String? // required (non-empty) before signing — enforced in the sign route, not the schema

  signedAt          DateTime?
  signatureImageKey String? // snapshot COPY of the author's stored signature (NurseProfile or User, per authorRole) taken at sign time — never a live reference, so a later signature change doesn't alter history

  voidedAt       DateTime?
  voidedByUserId String?
  voidReason     String?

  pdfS3Key String? // cached rendered PDF (lib/progressNotePdf.ts) — cleared/regenerated on sign, addendum, or void

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vitals       ProgressNoteVital[]
  intakeOutput ProgressNoteIntakeOutput[]
  addenda      ProgressNoteAddendum[]
  voiceEntries ProgressNoteVoiceEntry[]

  @@index([patientId])
  @@index([authorUserId])
  @@index([shiftId])
  @@index([serviceDate])
}

// "Micro-Charting" — a nurse dictates one of these per care event throughout
// the shift (via the quick-notes phone shortcut), each saved the instant it's
// transcribed. At end of shift these get compiled (lib/bedrockClient.ts) into
// one professionally-worded block that prepopulates shiftNotes above.
model ProgressNoteVoiceEntry {
  id             String       @id @default(uuid())
  progressNoteId String
  progressNote   ProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)
  rawText        String // transcribed text for this one dictated entry
  recordedAt     DateTime     @default(now()) // the authoritative chronological key — entries are always saved the instant they're captured, so creation order === chronological order

  @@index([progressNoteId])
}

// Appended, separately-signed corrections to an already-signed note — never
// alters the original note's text or signature. Composed and signed as one
// atomic action (not a draft/sign two-step like the main note itself).
model ProgressNoteAddendum {
  id             String       @id @default(uuid())
  progressNoteId String
  progressNote   ProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)

  authorUserId String?
  authorUser   User?  @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorRole   String // 'nurse' | 'admin'
  authorDisplayNameSnapshot String? // frozen at creation — addenda are signed atomically already

  text              String
  signatureImageKey String
  signedAt          DateTime @default(now())

  @@index([progressNoteId])
}

model ProgressNoteVital {
  id             String       @id @default(uuid())
  progressNoteId String
  progressNote   ProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)

  time       String?
  temp       String?
  hr         String?
  rr         String?
  skin       String?
  o2Flow     String?
  o2Route    String? // 'AirVo' | 'HME' | 'O2 Tank' | 'Passy Muir' | 'POC' | 'Vent' | 'Room Air'
  o2Percent  String?
  lungSounds String?
  txNeeded   String? // 'Yes' | 'No'
  suction    String?

  @@index([progressNoteId])
}

model ProgressNoteIntakeOutput {
  id             String       @id @default(uuid())
  progressNoteId String
  progressNote   ProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)

  time         String?
  intakeType   String?
  intakeAmt    String?
  intakeRoute  String? // 'Oral' | 'G-Tube' | 'J-Tube' | 'GJ-Split' | 'NG-Tube' | 'IV'
  outputUrine  String?
  outputBM     String?
  outputEmesis String?

  @@index([progressNoteId])
}

// Snapshot-on-every-save version history — mirrors ClaimAuditLog's proven
// pattern exactly (plain progressNoteId string, no relation; full-record JSON,
// not a diff). Only fires while the note is a draft — once signed, there are
// no more saves to log, so the log naturally becomes "draft history."
model ProgressNoteRevision {
  id             String   @id @default(uuid())
  progressNoteId String
  snapshot       Json
  savedAt        DateTime @default(now())
  savedBy        String

  @@index([progressNoteId])
  @@index([savedAt])
}

// A separate, narrowly-scoped credential for the /quick-notes home-screen
// shortcut (app/quick-notes/page.tsx) — conceptually an "app password," not
// a session. Verified by lib/nurseQuickAccess.ts entirely outside the normal
// cookie/JWT auth path; grants only create/edit/sign on the issuing nurse's
// own drafts and a read of their own active-patient list, nothing else.
model NurseQuickAccessToken {
  id          String  @id @default(uuid())
  nurseId     String
  nurse       NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  tokenHash   String  @unique // SHA-256 — see lib/nurseQuickAccess.ts for why not bcrypt
  deviceLabel String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([nurseId])
}

// Global custom medical-term dictionary backing lib/medicalSpellcheck.ts —
// supplements the bundled base English Hunspell dictionary so clinical/device
// terms and drug names stop getting flagged with no suggestion. Shared across
// all nurses (like a word processor's custom dictionary), not per-user.
model SpellcheckTerm {
  id            String   @id @default(uuid())
  term          String   @unique
  source        String // 'seed' | 'nurse-added'
  addedByUserId String?
  createdAt     DateTime @default(now())

  @@index([source])
}

model PatientPA {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  paNumber       String
  paStartDate    String?
  paEndDate      String?
  highTech       Boolean   @default(false)
  reminderSentAt DateTime? // set once the 3-weeks-before-paEndDate reminder fires
  createdAt      DateTime  @default(now())

  @@index([patientId])
}

model NursePatient {
  id                       String   @id @default(uuid())
  nurseId                  String // NurseProfile.id
  patientId                String
  overrides                Json? // nurse-level field corrections (merged on read)
  isActive                 Boolean  @default(true)
  medicationRemindersOptIn Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  nurse   NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  patient Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([nurseId, patientId])
  @@index([nurseId])
  @@index([patientId])
}

// Optional per-patient medication list — nurses, admins, or a linked guardian can
// maintain it; refill reminders are computed from lastFillDate/daySupply/refillsRemaining.
model PatientMedication {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  medicationName   String
  rxcui            String? // RxNorm concept id, captured from the typeahead selection — powers the drug-facts lookup (MedlinePlus Connect)
  dose             String? // prescribed dose amount, numeric only e.g. "15" — paired with doseUnit
  doseUnit         String? // unit for the prescribed dose, e.g. "mg", "mL", "tablet" — picked from a standard list in the UI
  unitStrength     String? // on-hand strength/amount, e.g. "10mg" — with dose, derives units-per-dose (e.g. 1.5 tablets)
  unitType         String? // on-hand form, e.g. "tablet", "capsule", "liquid", "spray"
  frequency        String? // prescribed frequency, e.g. "twice daily", "BID"
  route            String? // prescribed route of administration, e.g. "mouth", "G-Tube", "IM", "SQ"
  duration         String? // how long the order is valid before renewal, e.g. "30 days", "Ongoing"
  daySupply        Int      @default(30)
  lastFillDate     DateTime
  rxNumber         String?
  refillsRemaining Int?
  pharmacyId       String?
  pharmacy         Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  createdByUserId String // primary reminder recipient
  createdByRole   String // 'nurse' | 'guardian' | 'admin' — display attribution only

  reminderSentAt DateTime? // cleared on each refill confirm; set once a reminder fires this cycle

  // Refill status (Due/Overdue/Ordered/Filled) is computed on read from
  // lastFillDate/daySupply/refillsRemaining/refillOrderedAt (see
  // lib/medicationReminders.ts effectiveRefillStatus) rather than stored, so it
  // can never drift from the reminder cron's due-date math. Only the sticky
  // "an order is in flight" fact needs to persist.
  refillOrderedAt       DateTime? // cleared on each refill confirm; set when marked "RX Ordered"
  refillOrderedByUserId String?
  refillOrderedByRole   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([pharmacyId])
}

// Shared pharmacy directory — grows as medications are entered. Referenced by
// PatientMedication.pharmacyId; name/address/phone are looked up live (not
// snapshotted), so editing a pharmacy here updates every medication that uses it.
model Pharmacy {
  id          String              @id @default(uuid())
  name        String
  address     String?
  phone       String?
  medications PatientMedication[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([name])
}

// Grow-as-you-go local cache of drug names looked up via NIH's RxTerms API for
// the medication-name typeahead — no bulk/offline dataset exists, so this fills
// in organically as real medications get searched, so repeat lookups resolve
// instantly without depending on NIH's service being reachable.
model DrugName {
  id          String   @id @default(uuid())
  displayName String   @unique
  rxcui       String? // RxNorm concept id, when RxTerms supplied one for this name
  createdAt   DateTime @default(now())

  @@index([displayName])
}

// Family/guardian login scoped to exactly the patient(s) they're linked to.
model GuardianPatient {
  id                       String   @id @default(uuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId                String
  patient                  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationRemindersOptIn Boolean  @default(false)
  relationship             String? // 'Parent' | 'Guardian' | 'Caregiver' — descriptive title chosen by the inviter
  invitedByUserId          String? // who sent the invite — accountability trail for the HIPAA acknowledgment
  hipaaAcknowledgedAt      DateTime? // when the inviter acknowledged the HIPAA access-responsibility notice
  createdAt                DateTime @default(now())

  @@unique([userId, patientId])
  @@index([userId])
  @@index([patientId])
}

model MedicaidPayWeekLog {
  id          String    @id @default(uuid())
  nurseId     String
  depositDate String // YYYY-MM-DD — key for the pay week
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@unique([nurseId, depositDate])
  @@index([nurseId])
}
